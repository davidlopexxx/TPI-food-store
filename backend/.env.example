# Conexión a la base. PostgreSQL (recomendado):
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/foodstore_db
# Para desarrollo local también sirve SQLite (no hace falta instalar nada):
# DATABASE_URL=sqlite:///./foodstore.db

# Clave para firmar el JWT (mínimo 32 caracteres; cambiala por una propia)
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
# Minutos de vida del token y de la cookie
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173